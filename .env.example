# N.S. INTERIOR — Production Environment Variable Requirements
# Never commit real secret values to source control.

# Database URL (SQLite for local dev, PostgreSQL URI for production Vercel)
# Local: file:./dev.db
# Production (Supabase / Neon free tier): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Session Tokens
JWT_SECRET="your_production_secure_jwt_secret_key"

# Public Website Canonical URL
